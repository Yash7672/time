# Shell scripts must stay LF everywhere: a single CRLF in `gradlew` makes
# Linux/macOS runners fail with exit 126 ("bad interpreter").
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts must stay CRLF.
*.bat text eol=crlf

# Binary assets — never normalize.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.jks binary
*.keystore binary
