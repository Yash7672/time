<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose-only app: a minimal platform theme so there is no AppCompat /
         Material Components dependency. -->
    <style name="Theme.Chronos" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/chronos_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
