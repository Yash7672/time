<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- CHRONOS declares NO internet, contacts, location, microphone,
         camera, storage, overlay (SYSTEM_ALERT_WINDOW) or notification
         posting permission. The only special access is the consent-gated
         notification listener below. The ambient light sensor used for
         auto brightness needs no permission. -->

    <application
        android:name=".ChronosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chronos"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <!-- sensor = rotate with the device while THIS activity is open,
             regardless of the system rotation lock. The system rotation
             setting itself is never written, so the home screen and other
             apps are unaffected when CHRONOS is closed. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.Chronos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads other apps' notifications. Bound by the system only after the
             user explicitly grants notification-access in system settings. -->
        <service
            android:name=".notifications.NotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.allowed_listener_activity"
                android:value="com.chronos.clock/.MainActivity" />
        </service>
    </application>
</manifest>
