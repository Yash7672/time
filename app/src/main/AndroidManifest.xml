<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay (floating clock). Special access: requested at runtime only when
         the user enables the overlay feature in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required to run the optional overlay as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Only used to show the overlay's own foreground-service notification
         on Android 13+. CHRONOS never posts any other notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CHRONOS intentionally declares NO internet, contacts, location,
         microphone, camera or storage permission. -->

    <application
        android:name=".ChronosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chronos"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Chronos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads other apps' notifications. Bound by the system only after the
             user explicitly grants notification-access in system settings. -->
        <service
            android:name=".notifications.NotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.allowed_listener_activity"
                android:value="com.chronos.clock/.MainActivity" />
        </service>

        <!-- Optional floating clock overlay; only started after the user grants
             the "display over other apps" special access. Uses the specialUse
             foreground-service type: Android has no dedicated overlay type. -->
        <service
            android:name=".services.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Optional floating clock overlay shown over other apps at the user's request" />
        </service>
    </application>
</manifest>
